RAILWAY_ENVIRONMENT_NAME=local
SERVICE_NAME=cipher
SERVICE_VERSION=0.0.1
PORT=5160

# DATABASE_DRIVER picks the repository adapter; postgres is the only one today.
DATABASE_DRIVER=postgres
DATABASE_URL=postgres://pennywise:pennywise@localhost:5432/pennywise?sslmode=disable
REDIS_URL=redis://localhost:6379/0
OLLAMA_URL=http://localhost:11434
MLP_SERVICE_URL=
PENNYWISE_SERVICE_URL=http://localhost:5151
INTERNAL_AUTH_TOKEN=dev-internal-token-change-me

# Chat models come from each user's own providers (user_llm_providers).
# Same value as the API's; generate with: openssl rand -base64 32
LLM_CREDENTIALS_KEY=ZGV2LWxsbS1rZXktY2hhbmdlLW1lLTMyLWJ5dGVzISE=
# Let user Ollama URLs reach private addresses (single-user self-hosting only)
ALLOW_PRIVATE_LLM_URLS=true
LUMO_BASE_URL=
LUMO_API_KEY=
OPENAI_API_KEY=
# Embeddings only (EMAIL_EMBEDDING_PROVIDERS)
OPENROUTER_API_KEY=

TEMPORAL_SERVER_HOST=localhost
TEMPORAL_SERVER_PORT=7233

OTEL_SDK_DISABLED=true
OTEL_TRACES_EXPORTER=none
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_URL=
