# ── Required ────────────────────────────────────────────────────────────────
RAILWAY_ENVIRONMENT_NAME=local
SERVICE_NAME=cipher
SERVICE_VERSION=0.0.1
PORT=5160

DATABASE_DRIVER=postgres
DATABASE_URL=postgres://pennywise:pennywise@localhost:5432/pennywise?sslmode=disable
REDIS_URL=redis://localhost:6379/0
PENNYWISE_SERVICE_URL=http://localhost:5151

INTERNAL_AUTH_TOKEN=dev-internal-token-change-me
# Decrypts users' AI keys. Must match go-pennywise-api. Generate: openssl rand -base64 32
LLM_CREDENTIALS_KEY=ZGV2LWxsbS1rZXktY2hhbmdlLW1lLTMyLWJ5dGVzISE=

# Job queue. All services share these, so use the same Postgres URLs everywhere.
# Unset JOB_DRIVER turns the worker off.
JOB_DRIVER=postgres
JOB_BROKER_URL=postgres://pennywise:pennywise@localhost:5432/pennywise?sslmode=disable
JOB_STORE_URL=postgres://pennywise:pennywise@localhost:5432/pennywise?sslmode=disable
JOB_QUEUES=cipher

# ── Optional ────────────────────────────────────────────────────────────────
# Lets users' Ollama and decisions URLs reach private addresses.
# Only for single-user self-hosting; leave off on a shared server.
ALLOW_PRIVATE_LLM_URLS=true
# Tokens of the services allowed to call this one (name:token,...).
# Unset = accept INTERNAL_AUTH_TOKEN only.
# SERVICE_TOKENS=api:...,cipher:...,gmail:...
# Bound on one LLM call, e.g. 90s. Default 3m.
# CIPHER_LLM_CALL_TIMEOUT=

# Assistant
# AGENT_TITLE_MODEL=provider/model
# AGENT_MAX_TURNS=
# AGENT_MAX_TOOL_CALLS=
# AGENT_TIMEZONE=Asia/Kolkata
# Login role granted pennywise_agent_ro. Unset loses budget isolation for the agent's SQL tools.
# AGENT_DB_URL=

# Tracing
OTEL_SDK_DISABLED=true
OTEL_TRACES_EXPORTER=none
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
# LANGFUSE_OTEL_ENABLED=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_URL=

# ── Older Temporal/Gmail flow. Remove when it's retired ─────────────────────
OLLAMA_URL=http://localhost:11434
# MLP_SERVICE_URL=
# OPENAI_API_KEY=
# LUMO_BASE_URL=
# LUMO_API_KEY=
# TYPESAFE_API_KEY=
