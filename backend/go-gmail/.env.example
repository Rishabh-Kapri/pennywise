RAILWAY_ENVIRONMENT_NAME=local
PORT=5170

# DATABASE_DRIVER picks the repository adapter; postgres is the only one today.
DATABASE_DRIVER=postgres
DATABASE_URL=postgres://pennywise:pennywise@localhost:5432/pennywise?sslmode=disable
MLP_SERVICE_URL=
PENNYWISE_SERVICE_URL=http://localhost:5151
CIPHER_SERVICE_URL=http://localhost:5160
INTERNAL_AUTH_TOKEN=dev-internal-token-change-me
# Tokens of the services allowed to call this one (name:token,...). Unset = accept INTERNAL_AUTH_TOKEN only.
# SERVICE_TOKENS=api:...,cipher:...,gmail:...

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
CALLBACK_URL=http://localhost:5151/api/auth/google/callback
PROJECT_ID=
PUBSUB_TOPIC=
SUB_NAME=
NTFY_TOPIC=

TEMPORAL_SERVER_HOST=localhost
TEMPORAL_SERVER_PORT=7233
