# ── Required ────────────────────────────────────────────────────────────────
RAILWAY_ENVIRONMENT_NAME=local
SERVICE_NAME=pennywise-api
SERVICE_VERSION=0.0.1
PORT=5151

DATABASE_DRIVER=postgres
DATABASE_URL=postgres://pennywise:pennywise@localhost:5432/pennywise?sslmode=disable
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=dev-jwt-secret-change-me
DOMAIN=localhost
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ANDROID_CLIENT_ID=
CALLBACK_URL=http://localhost:5151/api/auth/google/callback

CIPHER_SERVICE_URL=http://localhost:5160
# Email sync setup (Settings -> Email sync) forwards here. Unset turns it off.
INGEST_SERVICE_URL=http://localhost:5180
INTERNAL_AUTH_TOKEN=dev-internal-token-change-me
# Seals users' AI keys. Must match cipher. Generate: openssl rand -base64 32
LLM_CREDENTIALS_KEY=ZGV2LWxsbS1rZXktY2hhbmdlLW1lLTMyLWJ5dGVzISE=

# Job queue. All services share these, so use the same Postgres URLs everywhere.
# Unset JOB_DRIVER turns the worker off.
JOB_DRIVER=postgres
JOB_BROKER_URL=postgres://pennywise:pennywise@localhost:5432/pennywise?sslmode=disable
JOB_STORE_URL=postgres://pennywise:pennywise@localhost:5432/pennywise?sslmode=disable
JOB_QUEUES=pennywise

# ── Optional ────────────────────────────────────────────────────────────────
# Enables POST /api/auth/demo (seeded demo user, no Google login). Off in production.
DEMO_MODE=true
# Tokens of the services allowed to call this one (name:token,...).
# Unset = accept INTERNAL_AUTH_TOKEN only.
# SERVICE_TOKENS=api:...,cipher:...,gmail:...

# Documents: "local" stores on disk under UPLOADS_DIR; anything else uses Postgres.
# DOCUMENT_STORAGE=
# UPLOADS_DIR=./data/uploads
# Reverse geocoding. Empty = public OSM Nominatim.
# NOMINATIM_URL=
# GEOCODE_COUNTRY_CODES=in
# Empty = the public Expo push endpoint.
# EXPO_PUSH_URL=
# SMS_DECISIONS_LOG=./data/sms-decisions.jsonl

# Tracing
# OTEL_SDK_DISABLED=true
# OTEL_TRACES_EXPORTER=none
# OTEL_METRICS_EXPORTER=none
# OTEL_LOGS_EXPORTER=none
# LANGFUSE_OTEL_ENABLED=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_URL=

# ── Older Temporal/Gmail flow. Remove when it's retired ─────────────────────
GMAIL_SERVICE_URL=http://localhost:5170
