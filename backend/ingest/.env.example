# ── Required ────────────────────────────────────────────────────────────────
RAILWAY_ENVIRONMENT_NAME=local
PORT=5180

DATABASE_DRIVER=postgres
DATABASE_URL=postgres://pennywise:pennywise@localhost:5432/pennywise?sslmode=disable

# Verifies user access tokens. Same value as go-pennywise-api. Unset = API keys only.
JWT_SECRET=dev-jwt-secret-change-me
INTERNAL_AUTH_TOKEN=dev-internal-token-change-me

# Job queue. All services share these, so use the same Postgres URLs everywhere.
# The memory driver can't reach cipher's worker.
JOB_DRIVER=postgres
JOB_BROKER_URL=postgres://pennywise:pennywise@localhost:5432/pennywise?sslmode=disable
JOB_STORE_URL=postgres://pennywise:pennywise@localhost:5432/pennywise?sslmode=disable
# Sends job updates to the API, so the Jobs screen updates live. Unset = off.
# REDIS_URL=redis://localhost:6379/0

# ── Optional ────────────────────────────────────────────────────────────────
# Tokens of the services allowed to call this one (name:token,...).
# go-pennywise-api must be able to call ingest. Unset = accept INTERNAL_AUTH_TOKEN only.
# SERVICE_TOKENS=api:...,gmail:...

# ── Email (needed once MAIL_PROVIDERS is set) ───────────────────────────────
# MAIL_PROVIDERS=gmail
# Seals mailbox credentials: openssl rand -base64 32.
# Changing it makes stored connections unreadable.
# CREDENTIALS_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_ANDROID_CLIENT_ID=
# PROJECT_ID=
# PUBSUB_TOPIC=
# Gmail push receiver: the Pub/Sub subscription to pull from. Unset = off.
# Don't point it at the subscription go-gmail uses while go-gmail still runs.
# SUB_NAME=
# GOOGLE_APPLICATION_CREDENTIALS_JSON=
