{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pennywise.local/contracts/core.schema.json",
  "description": "Core response contracts exercised against the real API by make smoke. Additive fields remain compatible.",
  "definitions": {
    "login": {
      "type": "object",
      "required": [
        "accessToken",
        "refreshToken",
        "expiresIn",
        "user"
      ],
      "properties": {
        "accessToken": {
          "type": "string",
          "minLength": 1
        },
        "refreshToken": {
          "type": "string",
          "minLength": 1
        },
        "expiresIn": {
          "type": "integer",
          "minimum": 1
        },
        "user": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "budgets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "budgetId",
          "name",
          "balance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "budgetId": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "balance": {
            "type": "number"
          }
        },
        "additionalProperties": true
      }
    },
    "createdTransactions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "budgetId",
          "accountId",
          "date",
          "outflow",
          "inflow",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "budgetId": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "accountId": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "date": {
            "type": "string",
            "minLength": 1
          },
          "outflow": {
            "type": "number"
          },
          "inflow": {
            "type": "number"
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  }
}
